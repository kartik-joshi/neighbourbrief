# Writer model (any OpenAI-compatible endpoint). Default: local Ollama.
LLM_PROVIDER=openai_compatible        # openai_compatible | azure_openai | anthropic
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=gemma3:12b

# Used only when LLM_PROVIDER=azure_openai
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=

# Used only when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Translation. If key is empty, fall back to the LLM for translation.
TRANSLATOR=auto                        # auto | azure | llm
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com

DEMO_OFFLINE=false                     # true = use data/demo_snapshot only, no network

# The app only answers this computer (127.0.0.1). Set true only on a trusted network.
ALLOW_LAN=false

# Two-person check (no accounts): a second person signs off by name before publishing.
# Role labels are shown on the Publish page and in each bulletin's history.
REQUIRE_REVIEW=false
ROLE_AUTHOR=Author
ROLE_REVIEWER=Reviewer
# Extra client networks that count as "this computer" (the Dockerfile sets Docker's bridge).
ALLOW_CLIENTS=

# Public site: who publishes it (a CPLC, residents' association, BIA, councillor's office). Never TPS branding.
PUBLISHER_NAME=
PUBLISHER_CONTACT=

# Optional: Cohere for "Ask about a neighbourhood" (embed + rerank retrieval, grounded answers with
# citations). Leave the key empty to use the local model or sources-only answers. LLM_PROVIDER=cohere
# also makes Cohere the bulletin writer.
COHERE_API_KEY=
COHERE_CHAT_MODEL=command-a-03-2025
COHERE_EMBED_MODEL=embed-multilingual-v3.0
COHERE_RERANK_MODEL=rerank-v5.0-fast
